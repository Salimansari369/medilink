{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MediLinks in Browser",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/serve.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Server running at (http://127\\.0\\.0\\.1:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
